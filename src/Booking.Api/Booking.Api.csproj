<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The integration tests drive the app through WebApplicationFactory,
         which needs the implicit Program class to be reachable. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Booking.Contracts\Booking.Contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.1"/>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.2"/>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Booking.Api.Tests"/>
  </ItemGroup>

</Project>
