<!--
    API-scoped policy for the Booking API.

    Applied by scripts/Import-ApimApi.ps1 after the OpenAPI document is imported.
    Order is not cosmetic: each stage below assumes the previous one has already
    rejected what it can, cheapest rejection first.

        1. ip-filter        no parsing, no crypto - the cheapest possible "no"
        2. validate-jwt     the caller is who they claim to be
        3. rate-limit-by-key  per-subscription, so one noisy partner cannot
                              throttle everyone else
        4. set-header       correlation id and forwarded identity
        5. set-backend-service  the Key Vault-backed backend key travels with it

    URL rewriting lives at operation scope, in operations/get-reservation.xml,
    because that is where the public path actually differs from the backend path.

    Subscription-key enforcement is not a policy: it is the product's
    subscriptionRequired setting, which APIM applies before any of this runs.

    Named values ({{...}}) are created by infra/modules/apim.bicep, so this file
    is environment-agnostic and can be committed verbatim.
-->
<policies>
    <inbound>
        <base />

        <!--
            Partner egress ranges. RFC 5737 documentation addresses are used as
            placeholders; replace them with real ranges before enabling.
            Left commented out because an empty allow-list rejects everything and
            an over-broad one is worse than none.

        <ip-filter action="allow">
            <address-range from="203.0.113.0" to="203.0.113.255" />
            <address>198.51.100.14</address>
        </ip-filter>
        -->

        <!--
            Entra ID token validation. openid-config is used rather than a pinned
            signing key so key rollover at the identity provider needs no change
            here. Clock skew is left at the default 5 minutes.
        -->
        <validate-jwt header-name="Authorization"
                      failed-validation-httpcode="401"
                      failed-validation-error-message="Unauthorized: a valid Entra ID access token is required."
                      require-expiration-time="true"
                      require-signed-tokens="true"
                      require-scheme="Bearer"
                      output-token-variable-name="jwt">
            <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <!-- The API's own application ID URI. A token minted for Graph or
                     any other resource must not be accepted here. -->
                <audience>{{entra-api-audience}}</audience>
            </audiences>
            <issuers>
                <issuer>https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0</issuer>
            </issuers>
            <required-claims>
                <!-- Application permission, because the caller is a partner system
                     rather than a signed-in person. -->
                <claim name="roles" match="any">
                    <value>Booking.Write</value>
                    <value>Booking.Read</value>
                </claim>
            </required-claims>
        </validate-jwt>

        <!--
            Rate limit keyed on the subscription, falling back to the caller IP for
            anything that somehow arrives without one. A single shared counter
            would let one partner exhaust the limit for all of them.

            The Starter and Premium products override this with their own limits;
            this is the floor that applies whatever product is used.
        -->
        <rate-limit-by-key calls="600"
                           renewal-period="60"
                           counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)"
                           increment-condition="@(context.Response == null || context.Response.StatusCode &lt; 500)"
                           remaining-calls-header-name="X-RateLimit-Remaining"
                           total-calls-header-name="X-RateLimit-Limit" />

        <!-- Daily ceiling as well as a per-minute one: a burst limit alone does
             not stop a slow, steady scrape. -->
        <quota-by-key calls="100000"
                      renewal-period="86400"
                      counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" />

        <!-- Adopt the caller's correlation id when present, otherwise mint one.
             The same value is returned in the response and ends up on the
             BookingCreated message the worker consumes. -->
        <set-header name="X-Correlation-ID" exists-action="skip">
            <value>@(context.RequestId.ToString())</value>
        </set-header>

        <!-- The backend logs who called without having to parse the token. -->
        <set-header name="X-Client-Id" exists-action="override">
            <value>@{
                if (!context.Variables.ContainsKey("jwt")) { return "unknown"; }
                var jwt = (Jwt)context.Variables["jwt"];
                string[] claim;
                // appid on v1 tokens, azp on v2 tokens.
                if (jwt.Claims.TryGetValue("appid", out claim)) { return claim[0]; }
                if (jwt.Claims.TryGetValue("azp", out claim)) { return claim[0]; }
                return "unknown";
            }</value>
        </set-header>

        <set-header name="X-Subscription-Name" exists-action="override">
            <value>@(context.Subscription?.Name ?? "none")</value>
        </set-header>

        <!-- Never forward the caller's bearer token to the backend. The App
             Service authenticates the gateway, not the partner. -->
        <set-header name="Authorization" exists-action="delete" />

        <!-- The backend carries the X-Backend-Key header, sourced from the
             Key Vault-backed named value in infra/modules/apim.bicep. -->
        <set-backend-service backend-id="booking-api" />
    </inbound>

    <backend>
        <!--
            20 seconds is well beyond the p99 for this API; anything slower is a
            failure the caller should learn about promptly.

            <base /> is deliberately absent: replacing the default forwarding with
            the retry wrapper below is the whole point of this section.
        -->
        <!--
            Retry only on a transport failure or a 5xx, and only for idempotent
            methods. Retrying a POST /bookings without an Idempotency-Key would
            create two bookings, which is why the condition checks the method.
        -->
        <retry condition="@(context.Response.StatusCode >= 500 || context.Response.StatusCode == 0)"
               count="2"
               interval="1"
               max-interval="4"
               delta="1"
               first-fast-retry="false">
            <forward-request timeout="20" />
        </retry>
    </backend>

    <outbound>
        <base />

        <!-- Security headers added at the edge so every backend gets them
             regardless of what it sets itself. -->
        <set-header name="Strict-Transport-Security" exists-action="override">
            <value>max-age=31536000; includeSubDomains</value>
        </set-header>
        <set-header name="X-Content-Type-Options" exists-action="override">
            <value>nosniff</value>
        </set-header>
        <set-header name="X-Gateway" exists-action="override">
            <value>azure-api-management</value>
        </set-header>

        <!-- Strip anything that describes the origin. A partner has no business
             knowing which web server or framework is behind the gateway. -->
        <set-header name="X-Powered-By" exists-action="delete" />
        <set-header name="X-AspNet-Version" exists-action="delete" />
        <set-header name="Server" exists-action="delete" />
    </outbound>

    <on-error>
        <base />

        <!--
            Errors the gateway itself produces - 401 from validate-jwt, 429 from
            the rate limiter - must look like errors from the API, or a client has
            two error formats to parse. The status is already set by the policy
            that failed; only the body and headers are normalised here.
        -->
        <set-header name="Content-Type" exists-action="override">
            <value>application/problem+json</value>
        </set-header>
        <set-header name="X-Correlation-ID" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
        </set-header>
        <set-body>@{
            var status = context.Response == null ? 500 : context.Response.StatusCode;
            var title = context.LastError == null ? "Gateway error" : context.LastError.Reason;
            // context.LastError.Message can contain internal detail, so only the
            // reason is surfaced.
            return new JObject(
                new JProperty("type", "https://httpstatuses.io/" + status),
                new JProperty("title", title),
                new JProperty("status", status),
                new JProperty("detail", "The request was rejected by the API gateway."),
                new JProperty("correlationId", context.RequestId.ToString())
            ).ToString();
        }</set-body>
    </on-error>
</policies>
